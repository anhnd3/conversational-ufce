{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ufce-agent://llm/config/parser_schema_v3.json",
  "title": "UFCE Bank CF Parser Output Schema v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task",
    "status",
    "cf_request",
    "field_evidence",
    "missing_fields",
    "conflicts",
    "notes"
  ],
  "properties": {
    "task": {
      "const": "extract_cf_request"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "needs_clarification",
        "conflict"
      ]
    },
    "cf_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Income": {
          "type": "number"
        },
        "CCAvg": {
          "type": "number"
        },
        "Family": {
          "type": "integer"
        },
        "Education": {
          "type": "integer"
        },
        "Mortgage": {
          "type": "number"
        },
        "CDAccount": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "Online": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "SecuritiesAccount": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "CreditCard": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        }
      }
    },
    "field_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Income": {
          "$ref": "#/$defs/fieldEvidence"
        },
        "CCAvg": {
          "$ref": "#/$defs/fieldEvidence"
        },
        "Family": {
          "$ref": "#/$defs/fieldEvidence"
        },
        "Education": {
          "$ref": "#/$defs/fieldEvidence"
        },
        "Mortgage": {
          "$ref": "#/$defs/fieldEvidence"
        },
        "CDAccount": {
          "$ref": "#/$defs/fieldEvidence"
        },
        "Online": {
          "$ref": "#/$defs/fieldEvidence"
        },
        "SecuritiesAccount": {
          "$ref": "#/$defs/fieldEvidence"
        },
        "CreditCard": {
          "$ref": "#/$defs/fieldEvidence"
        }
      }
    },
    "constraint_spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "immutable": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Income",
              "CCAvg",
              "Family",
              "Education",
              "Mortgage",
              "CDAccount",
              "Online",
              "SecuritiesAccount",
              "CreditCard"
            ]
          }
        },
        "disallowed_changes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Income",
              "CCAvg",
              "Family",
              "Education",
              "Mortgage",
              "CDAccount",
              "Online",
              "SecuritiesAccount",
              "CreditCard"
            ]
          }
        },
        "numeric_bounds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Income": {
              "$ref": "#/$defs/numericBounds"
            },
            "CCAvg": {
              "$ref": "#/$defs/numericBounds"
            },
            "Mortgage": {
              "$ref": "#/$defs/numericBounds"
            }
          }
        },
        "max_changed_features": {
          "type": "integer",
          "enum": [
            1,
            2,
            3
          ]
        },
        "prefer_fewer_changes": {
          "type": "boolean"
        }
      }
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Income",
          "CCAvg",
          "Family",
          "Education",
          "Mortgage",
          "CDAccount",
          "Online",
          "SecuritiesAccount",
          "CreditCard"
        ]
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "numericBounds": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "fieldEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_text",
        "evidence_kind",
        "normalized_from",
        "language"
      ],
      "properties": {
        "source_text": {
          "type": "string"
        },
        "evidence_kind": {
          "type": "string",
          "enum": [
            "explicit_numeric",
            "explicit_boolean",
            "unit_converted",
            "taxonomy_mapped",
            "conflict"
          ]
        },
        "normalized_from": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "enum": [
            "en",
            "vi",
            "mixed",
            "unknown"
          ]
        }
      }
    }
  }
}
